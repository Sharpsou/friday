[Unit]
Description=Friday Robot AlphaBot2-Pi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=friday-robot
Group=friday-robot
WorkingDirectory=/opt/friday-robot/robot
EnvironmentFile=/etc/friday-robot.env
ExecStart=/opt/friday-robot/venv/bin/python -m friday_robot --mode ${FRIDAY_ROBOT_MODE}
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RuntimeDirectory=friday-robot
ReadWritePaths=/run/friday-robot

[Install]
WantedBy=multi-user.target
