# Développement local uniquement. Aucun secret ne doit être préfixé par VITE_.
FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=8443
FRIDAY_DATA_DIR=D:\FridayData

# Laisser vides en développement HTTP loopback.
# Requis pour la recette LAN HTTPS.
FRIDAY_TLS_CERT_PATH=
FRIDAY_TLS_KEY_PATH=

# Classement facultatif des courses. Ollama reste sur la boucle locale.
FRIDAY_OLLAMA_URL=http://127.0.0.1:11434
FRIDAY_GROCERY_CLASSIFICATION_MODEL=ministral-3:8b
FRIDAY_GROCERY_CLASSIFICATION_TIMEOUT_MS=120000
