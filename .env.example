# Référence de configuration : pnpm dev/preview ne chargent pas ce fichier automatiquement.
# Passer les variables dans PowerShell ; voir docs/guides/installation-windows.md.
# Aucun secret ne doit être préfixé par VITE_. Les valeurs suivantes ne sont pas celles du foyer.
FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=8443
# Sans FRIDAY_DATA_DIR, Windows utilise %LOCALAPPDATA%\Friday.
# FRIDAY_DATA_DIR=C:\Users\votre-compte\AppData\Local\Friday
# Pour pnpm dev via Vite : http://127.0.0.1:5173 ; pour preview : http://127.0.0.1:8443.
FRIDAY_PUBLIC_ORIGIN=http://127.0.0.1:5173
FRIDAY_TLS_CERT_PATH=
FRIDAY_TLS_KEY_PATH=
FRIDAY_ROBOT_MODE=disabled
FRIDAY_CHAT_ENABLED=false
FRIDAY_CHAT_PIPELINE=unified
FRIDAY_CHAT_AXES_ENABLED=true
FRIDAY_OLLAMA_URL=http://127.0.0.1:11434
FRIDAY_GROCERY_CLASSIFICATION_MODEL=ministral-3:8b
FRIDAY_GROCERY_CLASSIFICATION_TIMEOUT_MS=120000
# FRIDAY_TAVILY_API_KEY reste un secret hors Git.
