{
  "name": "@friday/chat-eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "corpus:build": "tsx src/cli.ts corpus:build",
    "corpus:freeze": "tsx src/cli.ts corpus:freeze",
    "corpus:init": "tsx src/cli.ts corpus:init",
    "evaluate": "tsx src/cli.ts evaluate",
    "review:build": "tsx src/cli.ts review:build",
    "review:ai": "tsx src/cli.ts review:ai",
    "review:codex": "tsx src/cli.ts review:codex",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "campaign:unified": "tsx src/cli.ts campaign:unified"
  },
  "dependencies": {
    "@friday/assistant-core": "workspace:*",
    "jsdom": "30.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.3",
    "tsx": "4.23.1"
  }
}
