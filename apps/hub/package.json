{
  "name": "@friday/hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm --target node24 --sourcemap --clean --external better-sqlite3",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "10.1.3",
    "@friday/contracts": "workspace:*",
    "better-sqlite3": "13.0.3",
    "fastify": "5.11.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "tsup": "8.5.1",
    "tsx": "4.23.1"
  }
}
