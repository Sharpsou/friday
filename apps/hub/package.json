{
  "name": "@friday/hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm --target node24 --sourcemap --clean --external better-sqlite3",
    "dev": "tsx watch src/main.ts",
    "eval:grocery-classification": "tsx src/groceries/evaluate-grocery-classification.ts",
    "seed:budget": "tsx src/budget/budget-seed.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "10.1.3",
    "@friday/contracts": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "better-auth": "1.6.26",
    "better-sqlite3": "12.11.1",
    "fast-xml-parser": "^5.10.1",
    "fastify": "5.11.2",
    "jsdom": "^30.0.1",
    "undici": "8.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "^30.0.0",
    "tsup": "8.5.1",
    "tsx": "4.23.1"
  }
}
